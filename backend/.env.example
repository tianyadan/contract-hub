# Go 服务监听端口
SERVER_PORT=8080
# Gin 运行模式：debug / release / test
GIN_MODE=debug
# 业务数据库 MySQL DSN
MYSQL_DSN=root:your-password@tcp(127.0.0.1:3306)/contract_manager?charset=utf8mb4&parseTime=True&loc=Local
# JWT 密钥（生产环境务必替换为随机值，不要提交到代码仓库）
JWT_SECRET=please-change-me
# JWT 有效期（小时）
JWT_EXPIRE_HOURS=24
# Python Document Engine 内部服务地址
DOC_ENGINE_BASE_URL=http://127.0.0.1:9002
# 前端公开访问域名（二维码验真链接，生产环境请改为实际域名）
PUBLIC_WEB_ORIGIN=http://localhost:5173
# 局域网手机访问验真二维码时，改为本机局域网地址，例如：
# PUBLIC_WEB_ORIGIN=http://172.20.10.2:5173
# 阿里云 OSS 配置
OSS_ENDPOINT=oss-cn-qingdao.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=contract-hub
